# Copy to /etc/docflow/backup.env, set mode 600, and do not store shell syntax here.
MOUNT_POINT=/mnt/docflow-backup
SMB_SERVER=192.168.1.42
SMB_SHARE=backup
SMB_CREDENTIALS_FILE=/etc/docflow/smb.credentials
SMB_VERS=3.0
SMB_SEC=ntlmssp
POSTGRES_CONTAINER=docflow_db
POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=change-me
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=docflow

# Docker network of the target compose project; no published S3 port required.
S3_NETWORK=docs-register-and-track_default
DOCFLOW_SERVER_CONTAINER=docflow_server
S3_USE_SSL=false
