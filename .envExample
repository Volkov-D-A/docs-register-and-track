# ==========================================
# LOCAL DEVELOPMENT EXAMPLE ONLY.
# Не используйте значения из этого файла в production.
# Production .env должен храниться вне Git, иметь права 600 и содержать
# уникальные секреты. Для SMB предпочтительно задавать SMB_CREDENTIALS_FILE
# с правами 600 вместо передачи SMB_PASSWORD.
# ==========================================

# ==========================================
# Версии сервисов
# ==========================================
SEAWEEDFS_VERSION=4.46
POSTGRES_VERSION=18.3
SEQ_VERSION=2025.2.16020-x64
DOCFLOW_SERVER_VERSION=1.0.6
CADDY_VERSION=2.11.4-alpine

# ==========================================
# Management API docflow-server
# ==========================================
# Temporary external HTTP port published by Caddy.
DOCFLOW_SERVER_PORT=8080
DOCFLOW_SERVER_LISTEN_ADDRESS=:8080
DOCFLOW_AUTH_SESSION_TTL_HOURS=12

# ==========================================
# Настройки seq
# ==========================================
SEQ_ADMIN_PASSWORD=docflow_password
# Адрес из Docker network. Для запуска docflow-server на хосте используйте
# http://localhost:5341.
SEQ_URL=http://docflow_seq:80
SEQ_ENABLED=true

# ==========================================
# Настройки SeaweedFS
# ==========================================
S3_ACCESS_KEY_ID=docflow
S3_SECRET_ACCESS_KEY=docflow_password
# Адрес из Docker network. Для запуска docflow-server на хосте используйте
# отдельный override с публикацией 8333 только на loopback.
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=docflow-attachments
# Если S3_ENDPOINT содержит http:// или https://, значение определяется
# автоматически. Переменная нужна только для endpoint без схемы.
# S3_USE_SSL=false

# ==========================================
# Настройки PostgreSQL
# ==========================================
POSTGRES_USER=docflow
POSTGRES_PASSWORD=docflow_password
POSTGRES_DB=docflow
POSTGRES_CONTAINER=docflow_db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# ==========================================
# Настройки outbox worker в docflow-server
# ==========================================
DOCFLOW_OUTBOX_POLLING_INTERVAL_SECONDS=5
DOCFLOW_OUTBOX_BATCH_SIZE=50
DOCFLOW_OUTBOX_STALE_CLAIM_TIMEOUT_SECONDS=300
DOCFLOW_OUTBOX_CONSUMER_TIMEOUT_SECONDS=30
DOCFLOW_OUTBOX_PROCESSED_RETENTION_DAYS=90
DOCFLOW_OUTBOX_CLEANUP_INTERVAL_MINUTES=60

# ==========================================
# Настройки SMB для бэкапов
# ==========================================
SMB_SERVER=192.168.1.42
SMB_SHARE=backup
SMB_USER=ivan
SMB_PASSWORD=1234
SMB_DOMAIN=WORKGROUP
MOUNT_POINT=/mnt/smb_backup
# SMB_CREDENTIALS_FILE=/etc/docflow/smb-backup.credentials
