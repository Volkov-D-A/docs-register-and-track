# ==========================================
# LOCAL DEVELOPMENT EXAMPLE ONLY.
# Не используйте значения из этого файла в production.
# Production .env должен храниться вне Git, иметь права 600 и содержать
# уникальные секреты. Скопируйте этот файл в .env для локального Compose.
# SMB-доступ и расписание настраиваются в административной панели приложения.
# .env используется Compose для подстановки; сервер читает только переменные
# своего процесса. При запуске бинарного файла вне Docker передайте их явно.
# ==========================================

# ==========================================
# Версии сервисов
# ==========================================
SEAWEEDFS_VERSION=4.46
POSTGRES_VERSION=18.3
SEQ_VERSION=2025.2.16020-x64
# Версия для публикации и production-примера; локальный Compose собирает исходники.
DOCFLOW_SERVER_VERSION=1.0.6
CADDY_VERSION=2.11.4-alpine

# ==========================================
# Management API docflow-server
# ==========================================
# Внешний HTTP-порт локального Caddy.
DOCFLOW_SERVER_PORT=8080
# Адрес процесса сервера; в Compose закреплён как :8080.
DOCFLOW_SERVER_LISTEN_ADDRESS=:8080
DOCFLOW_AUTH_SESSION_TTL_HOURS=12

# ==========================================
# Настройки seq
# ==========================================
SEQ_ADMIN_PASSWORD=docflow_password
# Адрес в Docker network, также закреплён в Compose. Для запуска на хосте
# сначала опубликуйте порт Seq отдельным override и укажите фактический адрес.
SEQ_URL=http://seq:80
SEQ_ENABLED=true

# ==========================================
# Настройки SeaweedFS
# ==========================================
S3_ACCESS_KEY_ID=docflow
S3_SECRET_ACCESS_KEY=docflow_password
# Адрес из Docker network. Для запуска docflow-server на хосте используйте
# отдельный override с публикацией 8333 только на loopback.
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=docflow-attachments
# Если S3_ENDPOINT содержит http:// или https://, значение определяется
# автоматически. Переменная нужна только для endpoint без схемы.
# S3_USE_SSL=false

# ==========================================
# Настройки PostgreSQL
# ==========================================
POSTGRES_USER=docflow
POSTGRES_PASSWORD=docflow_password
POSTGRES_DB=docflow
# Имя сервиса в Docker network. Для запуска сервера на хосте нужны
# отдельная публикация порта PostgreSQL и соответствующие адрес/порт.
POSTGRES_CONTAINER=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# ==========================================
# Настройки outbox worker в docflow-server
# ==========================================
DOCFLOW_OUTBOX_POLLING_INTERVAL_SECONDS=5
DOCFLOW_OUTBOX_BATCH_SIZE=50
DOCFLOW_OUTBOX_STALE_CLAIM_TIMEOUT_SECONDS=300
DOCFLOW_OUTBOX_CONSUMER_TIMEOUT_SECONDS=30
DOCFLOW_OUTBOX_PROCESSED_RETENTION_DAYS=90
DOCFLOW_OUTBOX_CLEANUP_INTERVAL_MINUTES=60

# ==========================================
# Серверное резервирование: docker-compose.backup.example.yaml
# ==========================================
# SMB-сервер, share, подкаталог, пользователь, пароль, расписание и сроки хранения
# задаются в «Настройки → Резервные копии». SMB_* и MOUNT_POINT сервер не читает;
# монтирование SMB на хосте не требуется.
# Лимит постоянного staging, в байтах (20 GiB). Половина отводится под снимок,
# остальное — под упаковку архива. Применяется при подключении backup override.
DOCFLOW_BACKUP_MAX_BYTES=21474836480

# Раскомментируйте и укажите реальные абсолютные пути на Docker-хосте.
# Создайте два разных ключа вне Git: каждый — результат openssl rand -base64 32.
# Для Linux-контейнера файлы должны читаться UID 65532 (владелец 65532, права 0400).
# Сохраните отдельную защищённую копию ключей. Инструкция:
# docs/server-backup-operations.md
# DOCFLOW_SETTINGS_KEY_PATH=/etc/docflow/secrets/settings_key
# DOCFLOW_RECOVERY_KEY_PATH=/etc/docflow/secrets/recovery_key
# Сейчас backup override требует оба пути, даже без запуска профиля recovery.
# Отказ от recovery-панели и аварийного ключа пока только запланирован:
# docs/admin-backup-management-plan.md

# Пути ВНУТРИ контейнера backup override задаёт сам; в .env их менять бесполезно.
# При запуске сервера вне Compose задайте собственные абсолютные пути в окружении:
# DOCFLOW_BACKUP_DIRECTORY=/var/lib/docflow/backups
# DOCFLOW_SETTINGS_KEY_FILE=/run/secrets/settings_key
# Для существующего режима recovery (до реализации нового плана):
# DOCFLOW_RECOVERY_SECRET_FILE=/run/secrets/recovery_key
# DOCFLOW_RECOVERY_LISTEN_ADDRESS=127.0.0.1:8081

# ==========================================
# S3 secrets для docker-compose.prod.example.yaml
# ==========================================
# Production-пример читает S3-ключи из файлов на Docker-хосте вместо значений
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY выше. Укажите реальные пути вне Git.
# S3_ACCESS_KEY_FILE_PATH=/etc/docflow/secrets/s3_access_key
# S3_SECRET_KEY_FILE_PATH=/etc/docflow/secrets/s3_secret_key
# Внутренние S3_ACCESS_KEY_ID_FILE и S3_SECRET_ACCESS_KEY_FILE задаёт Compose.
