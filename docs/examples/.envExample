# ==========================================
# LOCAL DEVELOPMENT EXAMPLE ONLY.
# Не используйте значения из этого файла в production.
# Скопируйте этот файл в .env рядом с Compose: здесь настройки, логины и пути.
# Пароли и ключ шифрования хранятся отдельно в /etc/docflow/secrets, вне Git.
# SMB-доступ и расписание настраиваются в административной панели приложения.
# .env используется Compose для подстановки; сервер читает только переменные
# своего процесса. При запуске бинарного файла вне Docker передайте их явно.
# ==========================================

# ==========================================
# Версии
# ==========================================
SEAWEEDFS_VERSION=4.46
POSTGRES_VERSION=18.3
SEQ_VERSION=2025.2.16020-x64
DOCFLOW_SERVER_VERSION=1.0.6
CADDY_VERSION=2.11.4-alpine

# ==========================================
# Настройки SEQ
# ==========================================
SEQ_ADMIN_USERNAME=admin
SEQ_URL=http://seq:80
SEQ_ENABLED=true

# ==========================================
# Настройки SeaweedFS
# ==========================================
S3_ACCESS_KEY_ID=docflow
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=docflow-attachments


# ==========================================
# Настройки Postgres
# ==========================================
POSTGRES_USER=docflow
POSTGRES_DB=docflow
POSTGRES_CONTAINER=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# ==========================================
# Настройки docflow-server
# ==========================================
# HTTP API и сессии
DOCFLOW_SERVER_PORT=8080
DOCFLOW_SERVER_LISTEN_ADDRESS=:8080
DOCFLOW_AUTH_SESSION_TTL_HOURS=12

# Outbox worker
DOCFLOW_OUTBOX_POLLING_INTERVAL_SECONDS=5
DOCFLOW_OUTBOX_BATCH_SIZE=50
DOCFLOW_OUTBOX_STALE_CLAIM_TIMEOUT_SECONDS=300
DOCFLOW_OUTBOX_CONSUMER_TIMEOUT_SECONDS=30
DOCFLOW_OUTBOX_PROCESSED_RETENTION_DAYS=90
DOCFLOW_OUTBOX_CLEANUP_INTERVAL_MINUTES=60

# Резервирование
DOCFLOW_BACKUP_MAX_BYTES=21474836480

# ==========================================
# Файлы секретов
# ==========================================
# Укажите реальный абсолютный путь на Docker-хосте.
# Создайте ключ вне Git: openssl rand -base64 32.
# Файл должен читаться UID 65532 (владелец 65532, права 0400).
POSTGRES_PASSWORD_FILE_PATH=/etc/docflow/secrets/postgres_password
SEQ_ADMIN_PASSWORD_FILE_PATH=/etc/docflow/secrets/seq_admin_password
S3_SECRET_KEY_FILE_PATH=/etc/docflow/secrets/s3_secret_key
DOCFLOW_SETTINGS_KEY_PATH=/etc/docflow/secrets/settings_key